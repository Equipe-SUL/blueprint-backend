# PostgreSQL (Supabase ou local)
DB_NAME=seu_banco
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_HOST=localhost
DB_PORT=5432

# Ollama (servidor local de LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma4:31b-cloud
OLLAMA_VL_MODEL=gemma4:31b-cloud
OLLAMA_TEMPERATURE=0.1

# LangSmith (opcional — tracing de chains)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=blueprint-backend
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
